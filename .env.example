# Platform Credentials - Base64 encoded JSON
# Generate with: echo -n '{"clientId":"xxx","clientSecret":"yyy"}' | base64
# Each value maps to a PlatformID set on credentials in
# internal/nodeengine/credentials/**/credential.go. Empty values are skipped
# automatically — IsSupportPlatform is derived at startup from these.
PLATFORM_CREDENTIALS_AIRTABLE_API=
PLATFORM_CREDENTIALS_ANTHROPIC_API=
PLATFORM_CREDENTIALS_CHATGPT_API=
PLATFORM_CREDENTIALS_COINGECKO_API=
